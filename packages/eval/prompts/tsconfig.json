{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    // The harness runs directly under Node's type stripping (no build step),
    // so imports carry .ts extensions and only erasable syntax is allowed.
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2024",
    "lib": ["ES2024"],
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "types": ["node"]
  },
  "include": ["src", "test", "vitest.config.ts"]
}
