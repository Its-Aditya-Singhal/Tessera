{
  "name": "@tessera/eval-prompts",
  "version": "0.0.0",
  "private": true,
  "description": "Prompt-quality benchmark: original vs optimized prompts, judged pairwise and by checkable answers.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "eval": "node src/cli.ts",
    "eval:fake": "node src/cli.ts --fake",
    "validate-dataset": "node src/cli.ts --validate-only",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  }
}
