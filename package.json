{
  "name": "tessera-monorepo",
  "private": true,
  "description": "Tessera: a local-first layer for AI chatbots.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "dev": "pnpm --filter @tessera/extension dev",
    "build": "pnpm --filter @tessera/extension build",
    "build:e2e": "pnpm --filter @tessera/extension build:e2e",
    "zip": "pnpm --filter @tessera/extension zip",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "pnpm --filter @tessera/extension e2e",
    "eval:prompts": "pnpm --filter @tessera/eval-prompts eval",
    "eval:handoff": "pnpm --filter @tessera/eval-handoff eval:handoff",
    "eval:gate": "pnpm --filter @tessera/eval-prompts gate",
    "eval:capsule": "pnpm --filter @tessera/eval-handoff capsule",
    "eval:redaction": "pnpm --filter @tessera/eval-prompts exec jiti ../../core/scripts/redaction-report.ts",
    "site": "node scripts/build-site.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2"
  }
}
